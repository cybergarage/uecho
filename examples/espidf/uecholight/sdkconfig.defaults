# IPv4 ECHONET Lite multicast (224.0.23.0:3610) receive support.
CONFIG_LWIP_IPV4=y
CONFIG_LWIP_SO_REUSE=y
CONFIG_LWIP_SO_REUSE_RXTOALL=y
# Unicast and multicast receivers per interface plus application sockets.
CONFIG_LWIP_MAX_SOCKETS=10
CONFIG_UECHO_THREAD_STACK_SIZE=8192
CONFIG_ESP_MAIN_TASK_STACK_SIZE=4096
